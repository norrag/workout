# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only — never expose to the client bundle
SUPABASE_SERVICE_ROLE_KEY=

# MCP connector — resource server validates Supabase-issued JWTs against the
# project JWKS. Defaults below derive from NEXT_PUBLIC_SUPABASE_URL; override
# only if the OAuth authorization-server issuer differs from <url>/auth/v1.
MCP_AUTH_ISSUER=
# Optional explicit JWT issuer for token verification (defaults to <url>/auth/v1)
SUPABASE_JWT_ISSUER=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
