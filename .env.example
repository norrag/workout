# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only — never expose to the client bundle
SUPABASE_SERVICE_ROLE_KEY=

# MCP connector — resource server validates Supabase-issued JWTs against the
# project JWKS. Defaults below derive from NEXT_PUBLIC_SUPABASE_URL; override
# only if the OAuth authorization-server issuer differs from <url>/auth/v1.
MCP_AUTH_ISSUER=
# Optional explicit JWT issuer for token verification (defaults to <url>/auth/v1)
SUPABASE_JWT_ISSUER=

# Notes MCP tools (N67) — admin-gated intake/management of docs/notes/ through
# the connector. Fine-grained PAT, Contents:read+write on this repo ONLY; the
# server additionally restricts every write to docs/notes/**.md. Unset = the
# notes tools report the missing config; the rest of the connector is unaffected.
# Setup walkthrough: docs/deployment/manual-operations.md → NOTES_REPO_TOKEN.
NOTES_REPO_TOKEN=
# Optional overrides (defaults shown)
# NOTES_REPO=norrag/workout
# NOTES_REPO_BRANCH=main

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
